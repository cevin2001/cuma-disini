# Cloudflare Pages response headers. Rules that match the same path are merged,
# so each asset group gets its own non-overlapping pattern.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Images never change in place (a new image gets a new filename), so cache for a year.
/public/img/*
  Cache-Control: public, max-age=31536000, immutable
/public/og-image.png
  Cache-Control: public, max-age=31536000, immutable
/public/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/public/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS filenames are not fingerprinted, so keep the cache short enough for edits to show up.
/public/css/*
  Cache-Control: public, max-age=86400
/public/js/*
  Cache-Control: public, max-age=86400
